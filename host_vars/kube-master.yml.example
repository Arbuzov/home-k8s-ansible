# Example per-node overrides. Copy to host_vars/<node-name>.yml to apply.
# Anything set here wins over group_vars for that single host.
---
# Pin this node's container image registry to a local mirror, for example:
# kubernetes_image_repository: "registry.example.lan/google_containers"

# Give a beefier control-plane node more pods than the default:
# kubelet_max_pods: 150

# Mount an external USB disk on this node (roles/master/tasks/usb-mount.yml).
# Find the partition's UUID with `lsblk -f` / `blkid`. `nofail` keeps a missing
# disk from hanging boot; `x-systemd.device-timeout` waits for a slow-spinup
# HDD; passno 0 skips the boot fsck (right for exFAT/removable).
# usb_mounts:
#   - src: "UUID=XXXX-XXXX"
#     path: /mnt/usb
#     fstype: exfat
#     opts: "rw,nofail,nosuid,nodev,relatime,uid=1000,gid=1000,iocharset=utf8,errors=remount-ro,x-systemd.device-timeout=30"
#     passno: "0"
#     owner: "1000"
#     group: "1000"
#
# If the USB-SATA/NVMe bridge is unstable on the `uas` driver (I/O errors, resets,
# or the device dropping off the bus entirely), disable UAS for it by usb id.
# Common offenders: ASMedia ASM1051E/ASM1153, JMicron JMS583.
# Take the id from `lsusb` on the node itself — a quirk whose id matches no
# attached device is silently ignored, and the disk keeps running on `uas`.
# Written to cmdline.txt; needs a reboot.
# usb_storage_quirks: "152d:0583:u"
