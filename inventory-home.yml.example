# Example inventory — Kubernetes version is pinned per node.
# Copy to inventory-home.yml and adjust IPs / versions for your fleet.

all:
  children:
    kubernetes_cluster:
      children:
        masters:
          hosts:
            kube-master:
              ansible_host: 192.168.1.100
              wired_ip: 10.10.0.100          # optional: roles/wired copper backbone
              node_role: master
              node_taints: []                 # master also runs workloads
              kubernetes_version: "1.35.5"     # exact package version
              kubernetes_major_minor: "1.35"   # used for the apt repo URL
        workers:
          hosts:
            kube-worker-1:
              ansible_host: 192.168.1.101
              wired_ip: 10.10.0.101           # optional: roles/wired copper backbone
              node_role: worker
              kubernetes_version: "1.35.5"
              kubernetes_major_minor: "1.35"
            kube-worker-2:
              ansible_host: 192.168.1.102
              wired_ip: 10.10.0.102           # optional: roles/wired copper backbone
              node_role: worker
              kubernetes_version: "1.35.5"
              kubernetes_major_minor: "1.35"
            # A worker may trail the control plane by at most one minor
            # version (Kubernetes version-skew policy):
            kube-worker-3:
              ansible_host: 192.168.1.103
              wired_ip: 10.10.0.103           # optional: roles/wired copper backbone
              node_role: worker
              kubernetes_version: "1.34.8"
              kubernetes_major_minor: "1.34"

  vars:
    ansible_python_interpreter: /usr/bin/python3
    # StrictHostKeyChecking=no skips host-key verification — convenient when
    # provisioning fresh Pis whose keys aren't in known_hosts yet, but it allows
    # MITM on first connect. Prefer pre-seeding keys with `ssh-keyscan` and
    # dropping this line once the nodes are known.
    ansible_ssh_common_args: '-o StrictHostKeyChecking=no'

# Upgrade tips:
#   * Upgrade the control plane first, then workers one at a time.
#   * Never skip a minor version (1.33 -> 1.34 -> 1.35), kubeadm forbids it.
#   * A mixed-version fleet is fine within the version-skew policy.
