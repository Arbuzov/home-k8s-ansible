# Example node-update plan. Copy to node-updates.yml and run:
#   ansible-playbook playbooks/update-multiple-nodes.yml -e @node-updates.yml
# Versions must be full patch versions (e.g. "1.35.5").

node_updates:
  kube-master:
    version: "1.35.5"            # target Kubernetes version
    drain: false                 # don't drain a single-node control plane
    system_update: true          # also apt dist-upgrade the node
    apply_upgrade: true          # run kubeadm upgrade apply

  kube-worker-1:
    version: "1.35.5"
    drain: true                  # drain the node before upgrading
    system_update: true
    apply_upgrade: true

  kube-worker-2:
    version: "1.34.8"            # nodes may target different versions
    drain: true
    system_update: false         # skip OS package upgrade on this node
    apply_upgrade: true

# Extra options:
wait_between_nodes: 60           # seconds to pause between nodes
confirm_update: true             # prompt for confirmation before starting
